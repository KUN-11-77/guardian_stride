<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guardian_voice</name>
  <version>0.1.0</version>
  <description>Guardian Stride 语音交互模块：BOYA 麦克风 ASR + RealSense 障碍查询 + TTS 播报</description>
  <maintainer email="dev@guardian-stride.com">Guardian Stride Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-sounddevice</exec_depend>
  <exec_depend>python3-edge-tts</exec_depend>
  <exec_depend>python3-pygame</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-faster-whisper</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
